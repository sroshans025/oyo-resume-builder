# Infyro AI Resume — backend configuration
# Copy to backend/.env for local development. Never commit real secrets.

# --- Core --------------------------------------------------------------------
DJANGO_DEBUG=1                                   # 0 in production
DJANGO_SECRET_KEY=change-me-to-a-long-random-string   # required when DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173               # used in password-reset and reminder emails
LOG_LEVEL=INFO

# --- Database ------------------------------------------------------------------
# PostgreSQL in production. When unset, a local SQLite file (backend/db.sqlite3) is used.
# DATABASE_URL=postgres://infyro:infyro@localhost:5432/infyro

# --- HTTPS / cookies (production) --------------------------------------------------
SECURE_COOKIES=0                                  # 1 behind HTTPS
SECURE_SSL_REDIRECT=0
BEHIND_TLS_PROXY=0                                # 1 when a proxy sets X-Forwarded-Proto
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_AGE=1209600

# --- Background work & cache -------------------------------------------------------
# Without a broker, tasks run in-process (eager mode) — fine for development.
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_TASK_ALWAYS_EAGER=0

# --- File storage --------------------------------------------------------------------
# Default: private local folder (never served publicly).
PRIVATE_MEDIA_ROOT=./private_media
# For S3-compatible object storage install django-storages and set e.g.:
# FILE_STORAGE_BACKEND=storages.backends.s3.S3Storage   (+ AWS_* settings; use a PRIVATE bucket)
UPLOAD_MAX_BYTES=5242880
SIGNED_LINK_TTL_SECONDS=300
GENERATED_FILE_RETENTION_DAYS=30

# --- AI provider -------------------------------------------------------------------------
# offline   = rule-based assistant, no external calls (default; no key needed)
# anthropic = Claude via the Anthropic API (requires ANTHROPIC_API_KEY)
AI_PROVIDER=offline
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium                                  # low | medium | high
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=4000
AI_DAILY_REQUEST_LIMIT=100                         # per user, per day

# --- Rate limits (DRF throttle syntax) ------------------------------------------------------
THROTTLE_USER=1200/hour
THROTTLE_ANON=300/hour
THROTTLE_AUTH=20/minute
THROTTLE_AI=30/minute
THROTTLE_UPLOAD=20/hour

# --- Email -------------------------------------------------------------------------------------
# Console backend prints emails (e.g. password reset links) to the server log in development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Infyro <no-reply@localhost>

# --- Monitoring hook -----------------------------------------------------------------------------
# SENTRY_DSN=
